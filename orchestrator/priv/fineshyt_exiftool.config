# exiftool config defining Fineshyt's custom XMP namespace.
#
# exiftool refuses to write tags in a namespace it doesn't know about
# (`XMP-fineshyt:Subject doesn't exist or isn't writable`). This file
# registers the `fineshyt` namespace and its tags so the read-write
# sidecar path can persist our AI-derived metadata. Loaded via
# `exiftool -config <this file>` (see Orchestrator.Sidecars).
#
# Other editors (Lightroom, darktable, etc.) ignore unknown namespaces,
# so these tags are additive and never interfere with standard fields.

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        fineshyt => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::fineshyt',
            },
        },
    },
);

%Image::ExifTool::UserDefined::fineshyt = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-fineshyt', 2 => 'Image' },
    NAMESPACE => { 'fineshyt' => 'http://fineshyt.app/ns/1.0/' },
    WRITABLE  => 'string',
    PreferenceScore  => { Writable => 'real' },
    Subject          => { },
    ArtisticMood     => { },
    LightingCritique => { },
    ContentType      => { },
);

1;  #end
