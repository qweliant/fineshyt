{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fineshyt",
  "version": "0.1.0",
  "identifier": "com.qweliant.fineshyt",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fineshyt",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "resources": {
      "../runtime/bin/fineshyt-ai-worker": "bin/fineshyt-ai-worker",
      "../runtime/bin/llama/": "bin/llama/",
      "../runtime/phoenix/": "phoenix/"
    },
    "shortDescription": "Local-first photo culling that learns your taste",
    "longDescription": "Fineshyt is a self-hosted photo curation tool. Point it at a folder of photos, rate the ones you love, and it learns to surface more like that — all on your machine, nothing sent to the cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
